---
interface Props {
    match?: {
        day: string,
        number: string,
        category: string,
        id: string,
        date: string,
        hour: string,
        home: string,
        guest: string,
        place: string,
        isHome: boolean,
        status: string
    } | null;
}

const {match} = Astro.props;

const mapsUrl = match ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(match.place)}` : '#';
---
<main class="w-full h-100 bg-linear-to-b from-[#040811] via-[#040811] to-[#260508] pt-28   text-white">
    <div class="max-w-7xl mx-auto px-6 md:px-10">

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-red-900/50 bg-red-950/30 text-red-500 text-xs font-semibold tracking-wider uppercase mb-6">
            <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
            Campionato PGS
        </div>

        <h1 class="text-4xl md:text-6xl font-black tracking-tight uppercase mb-3">
            Under 15 <span class="text-red-600">Maschile</span>
        </h1>
        <p class="text-white/60 text-sm md:text-base mb-10">
            Calendario partite Under 15 Maschile.
        </p>

        <div class="w-full bg-white text-slate-900 rounded-2xl p-6 md:p-8 shadow-2xl border border-white/20">

            <div class="flex items-center justify-between pb-6 border-b border-slate-100 mb-6">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-black uppercase tracking-widest text-red-600">Prossima Partita</span>
                </div>
                {match && (
                        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 text-slate-600">
                        {match.date} • {match.hour}
                    </span>
                )}
            </div>

            {match ? (
                    <div class="flex flex-col gap-6">

                        <div class="grid grid-cols-1 md:grid-cols-5 items-center gap-4 bg-slate-50/80 border border-slate-100 rounded-xl p-6">

                            <div class="md:col-span-2 text-center md:text-left">
                                <span class="text-lg md:text-xl font-extrabold text-slate-900 leading-snug block">{match.home}</span>
                            </div>

                            <div class="flex justify-center my-2 md:my-0">
                                <div class="w-10 h-10 rounded-full bg-red-600 text-white font-black text-xs flex items-center justify-center shadow-md shadow-red-600/20">
                                    VS
                                </div>
                            </div>

                            <div class="md:col-span-2 text-center md:text-right">
                                <span class="text-lg md:text-xl font-extrabold text-slate-900 leading-snug block">{match.guest}</span>
                            </div>

                        </div>

                        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">

                            <div class="flex items-center gap-2.5 text-sm text-slate-600">
                            <span class="flex items-center justify-center w-8 h-8 rounded-lg   text-red-600 shrink-0">
                                📍
                            </span>
                                <div>
                                    <strong class="text-slate-900">{match.place}</strong>
                                </div>
                            </div>

                            <a
                                    href={mapsUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-red-600 text-white text-xs font-bold uppercase tracking-wider transition-all duration-300 shadow-md hover:shadow-lg group"
                            >
                                <span>Apri il navigatore</span>
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     class="h-4 w-4 transform group-hover:translate-x-0.5 transition-transform"
                                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                                </svg>
                            </a>

                        </div>

                    </div>
            ) : (
                    <div class="py-12 text-center text-slate-400 italic text-sm">
                        Nessuna partita imminente trovata in programma al momento.
                    </div>
            )}

        </div>

    </div>
</main>