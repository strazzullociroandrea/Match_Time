---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Match from '../components/Match.astro';
import type {MatchSchema} from "@/types/match-schema.ts";
import {CalendarDays, Clock, Code2, Info} from "lucide-react";

let matches: MatchSchema[] = [];
let firstMatchNear: MatchSchema | null = null;
let error: string | null = null;
let dividedPerMonth: Record<string, MatchSchema[]> = {};

try {
    const result = await fetch('https://calendarapi.blackbullsvolley.it/pgs', {
        method: "POST",
        headers: {
            "content-type": "application/json"
        },
        body: JSON.stringify({
            category: "Under 15 Maschile",
            team: "BLACK BULLS VOL. COLOGNO"
        })
    });

    if (!result.ok) {
        throw new Error(`HTTP error! status: ${result.status}`);
    }

    const data = await result.json();
    matches = Array.isArray(data?.matches) ? data.matches : [];

    firstMatchNear = matches.find(match => match.status === "In programma" || match.status === "Prossima") || matches[0] || null;

    matches.forEach((match: MatchSchema) => {
        const [dd, mm, yyyy] = match.date.split('/');
        const date = new Date(Number(yyyy), Number(mm) - 1, 1);
        const matchDate = new Date(date);
        let month = matchDate.toLocaleString('it-IT', {month: 'long', year: 'numeric'});


        if (!dividedPerMonth[month]) {
            dividedPerMonth[month] = [];
        }
        dividedPerMonth[month].push(match);
    });

} catch (e: any) {
    console.error("Errore nel recupero delle partite:", e);
    error = "Impossibile caricare il calendario al momento.";
}
---

<Layout>
    <Navbar match={firstMatchNear}/>
    <Hero match={firstMatchNear}/>

    {error ? (
            <div class="container mx-auto p-5 text-center text-red-500 font-medium">
                {error}
            </div>
    ) : (
            <>
                {firstMatchNear && (
                        <div class="container mx-auto -mt-24 p-5 relative z-10">
                            <Match match={firstMatchNear}/>
                        </div>
                )}

                <div class="container mx-auto p-5 mt-8 mb-12">
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-8 border-b border-border/60 pb-4">
                        <div class="flex items-center justify-between">
                            <h1 class="text-3xl font-black tracking-tight text-foreground">Calendario Partite</h1>
                            <span class="text-xs font-bold text-muted-foreground bg-muted px-3 py-1.5 rounded-full lg:hidden">
                                {matches.length} {matches.length === 1 ? 'Partita' : 'Partite'}
                            </span>
                        </div>

                        {Object.keys(dividedPerMonth).length > 0 && (
                                <div class="flex items-center gap-2 overflow-x-auto pb-2 lg:pb-0">
                                    <span class="text-xs font-semibold text-muted-foreground shrink-0 mr-1">Vai a:</span>
                                    {Object.keys(dividedPerMonth).map(month => (
                                            <a
                                                    href={`#${month}`}
                                                    class="px-3 py-1.5 text-xs font-bold rounded-xl bg-primary/10 border border-primary/20 text-primary hover:bg-primary hover:text-primary-foreground transition-all shrink-0 shadow-xs"
                                            >
                                                {month.charAt(0).toUpperCase() + month.slice(1)}
                                            </a>
                                    ))}
                                </div>
                        )}

                        <span class="hidden lg:inline-block text-xs font-bold text-muted-foreground bg-muted px-3 py-1.5 rounded-full shrink-0">
                            {matches.length} {matches.length === 1 ? 'Partita' : 'Partite'}
                        </span>
                    </div>

                    {matches.length === 0 ? (
                            <div class="text-center py-12 rounded-2xl border border-dashed border-border p-6 bg-card/50">
                                <p class="text-sm text-muted-foreground">Nessuna partita in calendario.</p>
                            </div>
                    ) : (
                            <div class="space-y-10">
                                {Object.keys(dividedPerMonth).map(month => (
                                        <div id={month} class="space-y-4 scroll-mt-24">
                                            <div class="flex items-center gap-3">
                                                <div class="flex items-center gap-2 px-3.5 py-1.5 bg-primary/10 border border-primary/20 rounded-xl text-primary font-black text-xs uppercase tracking-widest shadow-xs">
                                                    <CalendarDays className="w-4 h-4"/>
                                                    {month}
                                                </div>
                                            </div>

                                            <div class="space-y-3.5">
                                                {dividedPerMonth[month].map(match => (
                                                        <Match match={match}/>
                                                ))}
                                            </div>
                                        </div>
                                ))}
                            </div>
                    )}
                </div>
            </>
    )}

    <footer class="border-t border-border/60 bg-card/30 mt-20 pt-10 pb-8">
        <div class="container mx-auto px-5 flex flex-col gap-6 text-xs text-muted-foreground">

            <div class="flex items-start gap-3 p-4 rounded-xl bg-muted/40 border border-border/60 max-w-5xl mx-auto">
                <Info className="w-4 h-4 text-primary shrink-0 mt-0.5"/>
                <p class="leading-relaxed text-left">
                    Progetto indipendente. Tutti i dati visualizzati sono di proprietà del comitato
                    <span class="font-semibold text-foreground"> PGS Milano</span> e sono resi disponibili al pubblico
                    dagli stessi tramite il loro sito web.
                    L'applicazione si limita a facilitarne la consultazione. L'autore non è responsabile di eventuali
                    inesattezze o discrepanze nei dati mostrati.
                </p>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 text-center sm:text-left">
                <div class="flex items-center gap-1.5 font-medium">
                    <Clock className="w-3.5 h-3.5 text-primary"/>
                    <span>Ultimo aggiornamento: <span
                            class="font-semibold text-foreground">{new Date().toLocaleString('it-IT', {
                        dateStyle: 'short',
                        timeStyle: 'short'
                    })}</span></span>
                </div>

                <div class="flex items-center gap-1.5 font-medium">
                    <Code2 className="w-3.5 h-3.5 text-primary"/>
                    <span>
                        Sviluppato da{' '}
                        <a
                                href="https://cirostrazzullo.it"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-bold text-foreground hover:text-primary transition-colors underline underline-offset-4 decoration-primary/30 hover:decoration-primary"
                        >
                            Ciro A. Strazzullo
                        </a>
                    </span>
                </div>
            </div>

        </div>
    </footer>

</Layout>