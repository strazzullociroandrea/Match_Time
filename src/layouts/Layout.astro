---
import '../styles/global.css'
import {GoToUp} from "@/components/go-to-up.tsx";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/png" href="/logo.png"/>
    <link rel="icon" type="image/png" href="/logo.png"/>
    <meta name="description"
          content="Match Time è un'applicazione indipendente che mostra l'elenco delle partite di pallavolo del comitato PGS Milano in modo organizzato."/>

    <title>Calendario Partite | MatchTime </title>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Match Time" />
 </head>
<body>
<slot/>
<GoToUp client:load/>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
